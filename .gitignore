# manatee-open is its own git repo (separate remote/history); not nested here
# until it's pushed to a fork and wired in as a submodule.
/manatee-open/

# Swift Package Manager build output
ManateeKit/.build/
ManateeKit/.swiftpm/

# Xcode per-user/build state (Korpora.xcodeproj itself is generated by
# `xcodegen generate` from Korpora/project.yml, and is committed so the
# project doesn't need xcodegen installed just to open it)
Korpora/*.xcodeproj/xcuserdata/
Korpora/*.xcodeproj/project.xcworkspace/xcuserdata/

# Generated by Korpora/scripts/build-dev-corpus.sh - a throwaway corpus for
# running the app from Xcode, not real data. Visible (not dot-prefixed) -
# only .git and tool-managed build directories (.build/.swiftpm above) stay
# hidden in this project; everything else should be visible in Finder/Xcode.
Korpora/DevCorpus/

# Real corpus data (e.g. vertical files picked for Corpus Import) - large,
# not this project's own content, never meant to be tracked.
/data/

# Finder metadata
.DS_Store
