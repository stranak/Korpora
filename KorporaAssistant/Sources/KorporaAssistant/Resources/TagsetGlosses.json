  "czechPositionalTag": [
    "a 15-character positional tag; position N of the tag encodes one category, \"-\" means not applicable. Query it with a regular expression over the whole tag, \".\" for a position you don't care about, e.g. \"N...4.*\" (noun in the accusative), \"A.*\" (any adjective), \"V.......R.*\" (verb, past tense).",
    "1 part of speech: A adjective, C numeral, D adverb, I interjection, J conjunction, N noun, P pronoun, R preposition, T particle, V verb, X unknown, Z punctuation",
    "2 detailed part of speech (e.g. VB present verb, Vf infinitive, Vp past participle, Vs passive participle, J^ coordinating and J, subordinating conjunction, RR preposition, NN common noun)",
    "3 gender: M masculine animate, I masculine inanimate, F feminine, N neuter, Y masculine, H feminine or neuter, X any",
    "4 number: S singular, P plural, D dual, X any",
    "5 case: 1 nominative, 2 genitive, 3 dative, 4 accusative, 5 vocative, 6 locative, 7 instrumental, X any",
    "6 possessor's gender, 7 possessor's number (possessive pronouns and adjectives)",
    "8 person: 1, 2, 3",
    "9 tense: P present, R past, F future, H past or present",
    "10 degree: 1 positive, 2 comparative, 3 superlative",
    "11 negation: A affirmative, N negated",
    "12 voice: A active, P passive",
    "13 aspect (newer tagsets): P perfective, I imperfective, B both",
    "15 variant or style: - standard, 1-9 variants (e.g. colloquial or archaic forms)"
  ]
